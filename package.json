{
  "name": "dsh-menu-opacity",
  "version": "0.1.0",
  "description": "Adjustable opacity for DeepSeek Harness popup menus (composer +, model picker, permission, session menus).",
  "license": "MIT",
  "author": "linzexi",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linzexi/dsh-menu-opacity.git"
  },
  "homepage": "https://github.com/linzexi/dsh-menu-opacity#readme",
  "bugs": {
    "url": "https://github.com/linzexi/dsh-menu-opacity/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "menu",
    "opacity"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ]
}
